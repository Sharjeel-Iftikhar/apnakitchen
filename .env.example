# Copy to .env.local for local dev, and add the same keys in Vercel →
# Project → Settings → Environment Variables. README → "Connect Sanity" / "Order emails".

# ── Sanity (CMS) ─────────────────────────────────────────────
# Leave the project ID empty to run on the built-in mock catalogue.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer token: only needed if the dataset is set to private (paid plans). Orders are
# private either way (their IDs start with "orders.", which Sanity never serves publicly).
SANITY_API_READ_TOKEN=
# Editor token: saves orders and runs `npm run seed`. Server-only, never NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=
# Any long random string; paste the same value into the Sanity webhook's "Secret"
SANITY_REVALIDATE_SECRET=

# ── Order emails (Resend) ────────────────────────────────────
RESEND_API_KEY=
# Where new orders are sent (comma-separate for several)
ORDER_NOTIFY_EMAIL=orders@yourdomain.com
# Sender. Leave empty until your domain is verified in Resend (uses onboarding@resend.dev,
# which only delivers to your own Resend account email). Customer confirmations turn on once set.
ORDER_FROM_EMAIL=
# e.g. ORDER_FROM_EMAIL="Maison Crockery <orders@yourdomain.com>"

# ── Spam protection (Cloudflare Turnstile, optional) ─────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
